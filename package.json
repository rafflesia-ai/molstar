{
  "name": "headlessmolstar",
  "version": "1.0.0",
  "description": "Headless Mol* renderer CLI for agents. Note: the npm package name stays `headlessmolstar` because this package depends on the upstream `molstar` package, and npm forbids a self-named dependency. The binary is `molstar`.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/",
    "python/",
    "completions/",
    "schema/",
    "examples/",
    "docs/",
    "package.json"
  ],
  "scripts": {
    "doctor": "go run ./cmd/molstar doctor",
    "doctor:smoke": "go run ./cmd/molstar doctor",
    "build": "LDFLAGS=\"$(./scripts/build-ldflags.sh)\"; go build -ldflags \"$LDFLAGS\" -o bin/molstar ./cmd/molstar",
    "build:ts": "tsc -p tsconfig.json",
    "build:all": "LDFLAGS=\"$(./scripts/build-ldflags.sh)\"; go build -ldflags \"$LDFLAGS\" -o bin/molstar ./cmd/molstar && tsc -p tsconfig.json",
    "install:local": "go run ./cmd/molstar install-local --force",
    "package:local": "./scripts/package-local.sh",
    "test:artifact": "./scripts/verify-artifact.sh",
    "test:artifact:molstar": "./scripts/verify-artifact-molstar.sh",
    "test:release": "./scripts/verify-release.sh",
    "test:release:docker": "./scripts/verify-release-docker.sh",
    "test:release:docker:render": "./scripts/verify-release-docker.sh --render-docker",
    "test:linux-clean": "./scripts/verify-linux-clean.sh",
    "test:contracts": "go test ./internal/cli -run TestAgentJSONContract -count=1",
    "test:self": "go run ./cmd/molstar self-test --json",
    "test:assets": "./scripts/verify-generated-assets.sh",
    "audit:deps": "./scripts/audit-deps.sh",
    "ci:molstar-artifact": "./scripts/collect-molstar-ci-artifact.sh",
    "test:python": "python3 -m unittest discover -s python/tests",
    "bench:snapshot": "./scripts/benchmark-snapshot.sh",
    "dogfood:molstar": "./scripts/dogfood-molstar.sh",
    "dogfood:molstar:docker": "./scripts/dogfood-molstar-docker.sh",
    "dogfood:molstar:docker:render": "DOGFOOD_DOCKER_RENDER=render ./scripts/dogfood-molstar-docker.sh",
    "dogfood:molstar:docker:gpu": "DOGFOOD_DOCKER_GPU=1 DOGFOOD_DOCKER_RENDER=render ./scripts/dogfood-molstar-docker.sh",
    "dev:test": "./scripts/dev-test.sh",
    "dev:test:build": "docker build -f Dockerfile.dev-test -t molstar:dev-test .",
    "review:groups": "./scripts/review-change-groups.sh",
    "assets:cli": "./scripts/generate-cli-assets.sh",
    "docs:cli": "go run ./cmd/molstar docs --out docs/cli",
    "docker:build": "docker build -t molstar:local .",
    "docker:verify": "npm run docker:verify:runtime",
    "docker:verify:runtime": "DOCKER_VERIFY_PROFILE=runtime IMAGE=molstar:local ./scripts/verify-docker.sh",
    "docker:verify:render": "DOCKER_VERIFY_PROFILE=render IMAGE=molstar:local ./scripts/verify-docker.sh",
    "docker:verify:artifact": "IMAGE=molstar:local ./scripts/verify-docker-artifact.sh",
    "release:candidate": "./scripts/release-candidate.sh",
    "test": "go test ./...",
    "test:render": "go test ./internal/render -run TestGoldenRenderProbe -count=1",
    "schema": "go run ./cmd/molstar job schema --out schema/headlessmolstar-job-v1.schema.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "render:example": "go run ./cmd/molstar render examples/1cbs.job.yaml"
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "node": "^22.23.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "fp-ts": "^2.16.11",
    "gl": "^8.1.6",
    "jpeg-js": "^0.4.4",
    "molstar": "^5.10.1",
    "pngjs": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "node-gyp": "^13.0.1"
  }
}
