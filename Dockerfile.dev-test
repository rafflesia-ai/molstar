FROM node:22-bookworm

WORKDIR /workspace

COPY --from=golang:1.22-bookworm /usr/local/go /usr/local/go

ENV PATH="/usr/local/go/bin:${PATH}"

RUN ln -sf /usr/local/go/bin/go /usr/local/bin/go \
  && ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    g++ \
    git \
    libcairo2 \
    libcairo2-dev \
    libegl1 \
    libgif-dev \
    libgif7 \
    libgl1 \
    libgl1-mesa-dev \
    libglew-dev \
    libglu1-mesa \
    libglu1-mesa-dev \
    libjpeg-dev \
    libjpeg62-turbo \
    libpango-1.0-0 \
    libpango1.0-dev \
    libpangocairo-1.0-0 \
    librsvg2-2 \
    librsvg2-dev \
    libx11-6 \
    libxext6 \
    libxi-dev \
    libxi6 \
    make \
    pkg-config \
    python3 \
    python3-venv \
    xauth \
    xvfb \
  && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/local/bin/python

COPY package.json package-lock.json .npmrc ./
RUN npm ci

RUN if [ -x node_modules/node/bin/node ]; then \
    mv node_modules/node/bin/node node_modules/node/bin/node.real; \
    printf '%s\n' \
      '#!/usr/bin/env sh' \
      'exec xvfb-run -a "$(dirname "$0")/node.real" "$@"' \
      > node_modules/node/bin/node; \
    chmod +x node_modules/node/bin/node; \
  fi

COPY . .
RUN chmod +x scripts/dev-test-entrypoint.sh

ENV LIBGL_ALWAYS_SOFTWARE="1"
ENV LIBGL_DRI3_DISABLE="1"
ENV MOLSTAR_CONFIG="/tmp/headlessmolstar-dev-test-config.json"
ENV MOLSTAR_RENDER=""
ENV MOLSTAR_RENDER_FALLBACK=""
ENV MOLSTAR_VALIDATE=""

ENTRYPOINT ["./scripts/dev-test-entrypoint.sh"]
CMD ["bash"]
